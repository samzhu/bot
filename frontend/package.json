{
  "name": "bot-frontend",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --no-watch --no-progress && npm run test:parser",
    "test:unit": "ng test --no-watch --no-progress",
    "test:parser": "node --test src/app/sse-parser.spec.mjs",
    "test:guard": "node --test test/*.test.mjs"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@ag-ui/client": "1.0.4",
    "@ag-ui/core": "1.0.4",
    "@angular/cdk": "22.2.6",
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@angular/router": "22.2.5",
    "@json-render/core": "0.16.0",
    "@threadplane/a2ui": "0.3.7",
    "@threadplane/ag-ui": "0.3.7",
    "@threadplane/chat": "0.3.7",
    "@threadplane/render": "0.3.7",
    "@threadplane/telemetry": "0.3.7",
    "marked": "16.4.2",
    "rxjs": "7.8.1",
    "tslib": "^2.3.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.5",
    "jsdom": "^31.0.0",
    "puppeteer-core": "^25.17.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.12"
  }
}
