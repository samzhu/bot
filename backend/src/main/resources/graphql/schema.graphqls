enum WorkspaceRole { MANAGER MEMBER }

type Workspace { id: ID! name: String! role: WorkspaceRole! personal: Boolean! }

enum RunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum BotTarget {
  LOCAL
  GKE_REMOTE
}

enum ConnectionStatus {
  NOT_APPLICABLE
  NOT_CONNECTED
}

enum BotExecutionMode {
  LOCAL
  SPRING_AI_SIMULATION
  UNAVAILABLE
}

type Bot {
  id: ID!
  name: String!
  description: String
  instructions: String
  target: BotTarget!
  connectionStatus: ConnectionStatus!
  executionMode: BotExecutionMode!
  statusReason: String
  canChat: Boolean!
  createdAt: String!
  updatedAt: String!
}

input CreateBotInput {
  name: String!
  description: String
  instructions: String
}

input UpdateBotInput {
  id: ID!
  name: String!
  description: String
  instructions: String
}

type Message {
  id: ID!
  conversationId: ID!
  runId: ID!
  role: String!
  content: String!
  interrupted: Boolean!
  createdAt: String!
}

type Run {
  id: ID!
  conversationId: ID!
  clientRequestId: String!
  status: RunStatus!
  executionMode: String!
  errorMessage: String
  createdAt: String!
  updatedAt: String!
}

type Conversation {
  workspaceId: ID!
  id: ID!
  botId: ID!
  title: String!
  pinned: Boolean!
  createdAt: String!
  updatedAt: String!
  messages(limit: Int = 20, offset: Int = 0): [Message!]!
  runs(limit: Int = 20, offset: Int = 0): [Run!]!
}

type Query {
  workspaces: [Workspace!]!
  personalWorkspace: Workspace!
  bots(search: String, target: BotTarget, limit: Int = 20, offset: Int = 0): [Bot!]!
  bot(id: ID!): Bot
  defaultLocalBot: Bot
  conversations(workspaceId: ID, search: String, pinned: Boolean, limit: Int = 20, offset: Int = 0): [Conversation!]!
  conversation(id: ID!): Conversation
  run(id: ID!): Run
}

type Mutation {
  createConversation(botId: ID!, title: String, workspaceId: ID): Conversation!
  setConversationPinned(id: ID!, pinned: Boolean!): Conversation!
  createBot(input: CreateBotInput!): Bot!
  updateBot(input: UpdateBotInput!): Bot!
}

enum AttemptCoverage { VERIFIED UNKNOWN }
enum UsagePresence { PENDING PRESENT ABSENT UNKNOWN }
enum CaptureCompleteness { COMPLETE INCOMPLETE UNKNOWN }
enum RawUsageState { JSONB TEXT_FALLBACK UNAVAILABLE }
enum ProjectionState { VALID MISSING UNKNOWN }
enum NativeValuePresence { PRESENT NULL_VALUE MISSING UNKNOWN }
type NativeUsageValue { value: String presence: NativeValuePresence! meaning: String! }
enum UsageCostStatus { UNPRICED COMPLETE PARTIAL UNKNOWN NOT_DISPATCHED }
type UsageCostLineItem {
 category: String! nativeQuantity: String unit: String! meaning: String!
 rate: String rateBasis: String! exactAmount: String storedAmount: String reasons: [String!]!
}
type UsageCost {
 status: UsageCostStatus! amount: String @deprecated(reason: "Use completeAmount")
 knownSubtotal: String completeAmount: String currency: String! simulation: Boolean! needsReprice: Boolean!
 sourceProjectionVersion: String! estimateSourceVersion: String currentRevision: ID priceRevision: String
 priceSnapshotId: ID priceSourceReference: String priceEffectiveFrom: String priceEffectiveUntil: String
 calculatorVersion: String sourceSnapshotId: ID sourceLayer: String schemaVersion: String
 adapterVersion: String captureVersion: String captureCompleteness: String semantic: String ordinal: String
 reasons: [String!]! lineItems: [UsageCostLineItem!]!
}
type UsagePageInfo { hasNextPage: Boolean! endCursor: String }
type UsageAttemptConnection { nodes: [UsageAttempt!]! pageInfo: UsagePageInfo! }
type UsageSnapshotConnection { nodes: [UsageSnapshot!]! pageInfo: UsagePageInfo! }
type UsageAttempt {
 id: ID! workspaceId: ID! runId: ID providerRequestId: String providerResponseId: String preparedAt: String! startedAt: String finishedAt: String
 provider: String! endpoint: String! model: String! channel: String! executionOutcome: String!
 usagePresence: UsagePresence! captureCompleteness: CaptureCompleteness! projectionError: String
 projectionState: ProjectionState! projectionVersion: String! effectiveSnapshotId: ID simulation: Boolean! attemptCoverage: AttemptCoverage!
 input: NativeUsageValue! output: NativeUsageValue! cacheRead: NativeUsageValue! cacheWrite: NativeUsageValue!
 cost: UsageCost! snapshots(first: Int = 20, after: String): UsageSnapshotConnection!
}
type UsageSnapshot {
 id: ID! eventId: String! ordinal: String! semantic: String! sourceLayer: String! schemaVersion: String!
 adapterVersion: String! captureVersion: String! captureCompleteness: CaptureCompleteness! rawState: RawUsageState!
 rawUsage: String captureReason: String capturedAt: String!
}
extend type Query {
 myUsageAttempts(workspaceId: ID!, first: Int = 20, after: String): UsageAttemptConnection!
 myUsageAttempt(workspaceId: ID!, id: ID!): UsageAttempt
}
