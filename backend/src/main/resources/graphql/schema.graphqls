enum RunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum BotTarget {
  LOCAL
  GKE_REMOTE
}

enum ConnectionStatus {
  NOT_APPLICABLE
  NOT_CONNECTED
}

enum BotExecutionMode {
  LOCAL
  SPRING_AI_SIMULATION
  UNAVAILABLE
}

type Bot {
  id: ID!
  name: String!
  description: String
  instructions: String
  target: BotTarget!
  connectionStatus: ConnectionStatus!
  executionMode: BotExecutionMode!
  statusReason: String
  canChat: Boolean!
  createdAt: String!
  updatedAt: String!
}

input CreateBotInput {
  name: String!
  description: String
  instructions: String
}

input UpdateBotInput {
  id: ID!
  name: String!
  description: String
  instructions: String
}

type Message {
  id: ID!
  conversationId: ID!
  runId: ID!
  role: String!
  content: String!
  interrupted: Boolean!
  createdAt: String!
}

type Run {
  id: ID!
  conversationId: ID!
  clientRequestId: String!
  status: RunStatus!
  executionMode: String!
  errorMessage: String
  createdAt: String!
  updatedAt: String!
}

type Conversation {
  id: ID!
  botId: ID!
  title: String!
  pinned: Boolean!
  createdAt: String!
  updatedAt: String!
  messages(limit: Int = 20, offset: Int = 0): [Message!]!
  runs(limit: Int = 20, offset: Int = 0): [Run!]!
}

type Query {
  bots(search: String, target: BotTarget, limit: Int = 20, offset: Int = 0): [Bot!]!
  bot(id: ID!): Bot
  defaultLocalBot: Bot
  conversations(search: String, pinned: Boolean, limit: Int = 20, offset: Int = 0): [Conversation!]!
  conversation(id: ID!): Conversation
  run(id: ID!): Run
}

type Mutation {
  createConversation(botId: ID!, title: String): Conversation!
  setConversationPinned(id: ID!, pinned: Boolean!): Conversation!
  createBot(input: CreateBotInput!): Bot!
  updateBot(input: UpdateBotInput!): Bot!
}
